{
  "rewrites": [
    {
      "source": "/api/oauth",
      "destination": "/api/oauth"
    },
    {
      "source": "/api/gigachat/:path*",
      "destination": "/api/gigachat/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite"
}